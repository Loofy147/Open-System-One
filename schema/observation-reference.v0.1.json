{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Loofy147/Open-System-One/blob/control-plane/kernel-contract-v0.1/schema/observation-reference.v0.1.json",
  "title": "Observation Reference v0.1",
  "description": "Minimal reference to an observed result attributable to a run and source. Observation is not Evidence and does not establish truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "run_id",
    "source_ref",
    "payload_digest",
    "recorded_at"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "payload_digest": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}