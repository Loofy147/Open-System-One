{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Loofy147/Open-System-One/blob/control-plane/kernel-contract-v0.1/schema/cache-reference.v0.1.json",
  "title": "Cache Reference v0.1",
  "description": "A cache is a valuable reusable Artifact: a materialized value derived from identifiable sources. Reusability does not establish semantic authority or truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cache_id",
    "kind",
    "derived_from",
    "source_ref",
    "integrity_digest",
    "status",
    "reuse_policy",
    "invalidation_conditions",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "cache_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "derived_from": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "integrity_digest": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "invalid",
        "superseded",
        "unknown"
      ]
    },
    "reuse_policy": {
      "type": "string",
      "enum": [
        "reusable",
        "revalidate_before_use",
        "non_reusable"
      ]
    },
    "invalidation_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "freshness_basis": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_validated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "evidence_role": {
      "type": "string",
      "enum": [
        "not_evidence",
        "derived_copy"
      ]
    },
    "authority": {
      "type": "string",
      "const": "none"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}