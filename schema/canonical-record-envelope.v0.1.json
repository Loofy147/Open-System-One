{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Loofy147/Open-System-One/blob/architecture/convergence-v0.1-2026-10-02/schema/canonical-record-envelope.v0.1.json",
  "title": "Open System One Canonical Record Envelope v0.1",
  "description": "Draft minimum cross-repository linkage envelope. Type-specific payloads remain local until conformance experiments establish a stable shared boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "record_type", "schema_version", "recorded_at", "source", "payload"],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "type": "string",
      "enum": [
        "intent", "plan", "action", "run", "capability_invocation",
        "observation", "verification", "evidence", "artifact",
        "claim", "decision", "decision_revision",
        "relationship", "contradiction", "gap"
      ]
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "commit": { "type": "string" }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parent_id": { "type": ["string", "null"] },
        "run_id": { "type": ["string", "null"] },
        "observation_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "verification_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidence_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "artifact_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "status": {
      "type": "string"
    },
    "disposition": {
      "type": "string",
      "enum": [
        "CONFIRMED", "PARTIALLY_CONFIRMED", "CONTRADICTED",
        "REFINED", "INCONCLUSIVE", "INVALID_RESULT",
        "CONTEXT_BOUND", "REGRESSION", "NOVEL_SIGNAL", "OPEN"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
