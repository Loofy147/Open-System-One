  "state_machine": {
    "states": [
      "RESERVED",
      "UNKNOWN",
      "COMPLETED",
      "CONFIRMED_NOT_EXECUTED"
    ],
    "legal_transitions": [
      {
        "from": "RESERVED",
        "to": "COMPLETED",
        "requires": "execution acknowledgement"
      },
      {
        "from": "RESERVED",
        "to": "UNKNOWN",
        "requires": "ambiguous execution boundary"
      },
      {
        "from": "UNKNOWN",
        "to": "COMPLETED",
        "requires": "valid attestation for exact effect identity and attempt"
      },
      {
        "from": "UNKNOWN",
        "to": "CONFIRMED_NOT_EXECUTED",
        "requires": "valid attestation for exact effect identity and attempt"
      }
    ],
    "replay_rules": [
      "UNKNOWN blocks execution for that attempt.",
      "COMPLETED is terminal for the logical effect identity.",
      "CONFIRMED_NOT_EXECUTED permits only a new attempt_id and incremented attempt_number; prior attempt history remains append-only.",
      "An attestation for an old attempt cannot resolve a newer attempt.",
      "UNRESOLVED is recorded but leaves the effect in UNKNOWN."
    ]
  },
