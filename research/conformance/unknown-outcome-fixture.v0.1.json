      "id": "U-01",
      "name": "unknown blocks replay until reconciliation",
      "assertions": [
        "reserve effect",
        "mark effect UNKNOWN",
        "same effect reservation is blocked",
        "reconcile UNKNOWN to COMPLETED",
        "effect count remains one"
      ]
    },
    {
      "id": "U-02",
      "name": "confirmed not executed permits later reservation",
      "assertions": [
        "reserve effect",
        "mark effect UNKNOWN",
        "reconcile UNKNOWN to CONFIRMED_NOT_EXECUTED",
        "same effect can be reserved again",
        "new execution can occur once"
      ]
    },
    {
      "id": "U-03",
      "name": "recovery converts stale reservation to UNKNOWN",
      "assertions": [
        "reserve effect",
        "recover interrupted effects",
        "effect becomes UNKNOWN",
        "replay remains blocked until reconciliation"
      ]
    }
  ]
